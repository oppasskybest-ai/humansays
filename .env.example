# ===== HumanSays environment variables (NAMES ONLY. Never commit real values) =====
# Copy to .env.local and fill in. See HUMANSAYS_BUILD_SPEC.md section 13.
# All of these are read ONLY in src/lib/config.ts.

# --- Environment / Pi (Switch A) ---
PI_ENV=staging                       # staging | production
NEXT_PUBLIC_PI_SANDBOX=true          # true while testing in the Pi Sandbox, false in Pi Browser/production
PI_API_KEY=                          # SECRET. Server API Key of THIS environment's Pi app
PI_WALLET_SEED=                      # SECRET. Only needed when PAYOUT_MODE=pi_a2u

# --- Money flags (Switch B) ---
FUNDING_MODE=credits_only            # pi | credits_only
PAYOUT_MODE=points                   # points | pi_a2u
PLATFORM_FEE_BPS=1000                # 1000 = 10%
MIN_REWARD_STROOPS=10000             # minimum reward per response (1 Pi = 10,000,000 stroops)
MIN_WITHDRAW_STROOPS=1000000
NEXT_PUBLIC_STROOPS_PER_POINT=10000  # points display rate (client + server)

# --- Rules / limits ---
MAX_RESPONSES_PER_DAY=20
MODERATION_REQUIRED=true
AI_DAILY_CAP_PER_USER=20

# --- Secrets ---
SESSION_SECRET=                      # SECRET. 32+ random characters (JWT signing)
CRON_SECRET=                         # SECRET. protects /api/cron/*
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # SECRET. server only
ANTHROPIC_API_KEY=                   # SECRET. optional (AI features hidden if empty)
ANTHROPIC_MODEL=                     # check current model names in Anthropic docs

# --- App ---
ADMIN_UIDS=                          # comma-separated verified Pi uids
APP_BASE_URL=http://localhost:3000
